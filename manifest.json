{
  "manifest_version": 3,
  "name": "UnsubSweep: Bulk Unsubscribe for Gmail",
  "short_name": "UnsubSweep",
  "version": "1.0.0",
  "description": "Bulk unsubscribe from Gmail newsletters in one click. Runs in your browser: no inbox access, no servers, no data.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
